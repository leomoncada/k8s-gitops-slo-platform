From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Orders Team <orders-team@example.com>
Date: Fri, 2 Oct 2026 14:12:37 +0000
Subject: [PATCH] refactor(api): normalise whitespace in order text fields

Notes pasted from email and chat apps arrive with stray newlines, tabs and
double spaces, and the mobile app renders them verbatim. Normalise text
fields once, at the serialization boundary, so every endpoint returns the
same canonical form:

- note: collapse runs of whitespace into a single space
- customer_id: strip surrounding whitespace

Stored data is unchanged; only responses are affected.

Release 1.1.0.
---
 app/Dockerfile              |  2 +-
 app/orders/__init__.py      |  2 +-
 app/orders/serialization.py | 11 ++++++++---
 3 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/app/Dockerfile b/app/Dockerfile
index 40234e8..2675db1 100644
--- a/app/Dockerfile
+++ b/app/Dockerfile
@@ -19,7 +19,7 @@ RUN python -m compileall -q --invalidation-mode checked-hash /srv/orders
 # --- runtime ---------------------------------------------------------------
 FROM ${PYTHON_IMAGE}
 
-ARG APP_VERSION=1.0.0
+ARG APP_VERSION=1.1.0
 LABEL org.opencontainers.image.title="orders" \
       org.opencontainers.image.version="${APP_VERSION}"
 
diff --git a/app/orders/__init__.py b/app/orders/__init__.py
index 3646198..b8c9603 100644
--- a/app/orders/__init__.py
+++ b/app/orders/__init__.py
@@ -1,4 +1,4 @@
 """orders: a small FastAPI service built to fail in realistic ways."""
 
 # Default release version. Images override it with the APP_VERSION build arg.
-__version__ = "1.0.0"
+__version__ = "1.1.0"
diff --git a/app/orders/serialization.py b/app/orders/serialization.py
index c6a8db2..adc9742 100644
--- a/app/orders/serialization.py
+++ b/app/orders/serialization.py
@@ -4,12 +4,17 @@ from collections.abc import Mapping
 from typing import Any
 
 
+def _squash_whitespace(text: str) -> str:
+    """Collapse runs of whitespace (newlines, tabs, double spaces) into one space."""
+    return " ".join(text.split())
+
+
 def serialize_order(row: Mapping[str, Any]) -> dict[str, Any]:
-    """Turn an ``orders`` row into the response body. ``note`` may be null."""
+    """Turn an ``orders`` row into the response body, with text fields normalised."""
     return {
         "id": row["id"],
-        "customer_id": row["customer_id"],
+        "customer_id": row["customer_id"].strip(),
         "items": row["items"],
-        "note": row["note"],
+        "note": _squash_whitespace(row["note"]),
         "created_at": row["created_at"].isoformat(),
     }
