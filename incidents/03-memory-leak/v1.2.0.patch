@@ -0,0 +1,26 @@
+"""Replay snapshots of recent responses, for debugging customer reports.
+
+Support regularly asks "what exactly did the API return for this request?",
+and the access log only has the status and the latency. Every served request
+leaves a snapshot keyed by its trace id (the id in each log line and in
+Tempo), which ``GET /debug/replay/{trace_id}`` returns verbatim.
+"""
+
+import time
+
+# Snapshots are fixed-size records so the replay tool can read them at fixed
+# offsets. 256 KiB holds a full ``GET /orders?limit=100`` page with room to spare.
+REPLAY_BUFFER_BYTES = 256 * 1024
+
+_snapshots: dict[str, bytes] = {}
+
+
+def record(trace_id: str, method: str, route: str, status: int, body: bytes) -> None:
+    header = f"{time.time():.6f} {method} {route} {status}\n".encode()
+    # Space padding keeps the record readable when dumped to a terminal.
+    _snapshots[trace_id] = (header + body)[:REPLAY_BUFFER_BYTES].ljust(REPLAY_BUFFER_BYTES)
+
+
+def lookup(trace_id: str) -> bytes | None:
+    snapshot = _snapshots.get(trace_id)
+    return None if snapshot is None else snapshot.rstrip()
