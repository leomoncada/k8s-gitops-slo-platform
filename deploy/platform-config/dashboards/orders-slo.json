        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 9,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:current_burn_rate:ratio{sloth_service=\"orders\", sloth_slo=\"requests-latency\"}",
          "datasource": {
            "type": "prometheus",
