              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "30 days locally; 1 hour with the compressed CI windows (ADR 6)."
    },
