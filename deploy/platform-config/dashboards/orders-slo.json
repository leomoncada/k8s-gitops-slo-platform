    },
    {
      "type": "timeseries",
      "title": "SLO alerts firing",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alertname, severity) (ALERTS{alertstate=\"firing\", sloth_service=\"orders\"})",
          "legendFormat": "{{alertname}} ({{severity}})",
          "datasource": {
